fgdjtutbucnhdpbjobgmx34rtb6jztwy._domainkey.pinelakecc.com.	14400	IN	CNAME	fgdjtutbucnhdpbjobgmx34rtb6jztwy.dkim.amazonses.com.
lqdjysclbun6mfr7nhd4y5duon3afovp._domainkey.pinelakecc.com.	14400	IN	CNAME	lqdjysclbun6mfr7nhd4y5duon3afovp.dkim.amazonses.com.
xpz24sk4bzcdhme6vtg7zk4xnhxtw7xl._domainkey.pinelakecc.com.	14400	IN	CNAME	xpz24sk4bzcdhme6vtg7zk4xnhxtw7xl.dkim.amazonses.com.

;; SendGrid DKIM for the emails.pinelakecc.com sending subdomain.
s2._domainkey.emails.pinelakecc.com.	7200	IN	CNAME	s2.domainkey.u4668611.wl112.sendgrid.net.

;; --- Live hosts ---

;; Another Northstar-hosted name, same target as members.
clubnow.pinelakecc.com.	1800	IN	CNAME	pinelakecc-com.northstar-connect.com.

