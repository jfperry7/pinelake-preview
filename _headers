# Cloudflare headers.

# Search-engine control is NOT here. One deployment serves both the staging
# .workers.dev URL and the live domain, so indexing has to be decided per
# hostname - which `_headers` cannot do. It lives in `worker.js` instead.

# Long cache on fingerprint-stable assets. Images are replaced by name when
# they change, so keep this modest rather than immutable.
/img/*
  Cache-Control: public, max-age=86400
