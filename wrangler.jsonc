{
  // Cloudflare's Git integration creates a Worker with static assets, not a
  // Pages project, so the site needs an explicit entry point for the one
  // dynamic route. Everything else is served straight from the repo root.
  "name": "pinelake-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",

    // WHICH REQUESTS RUN worker.js FIRST.
    //
    // A Worker with static assets does not invoke the script for a request
    // that matches an asset file unless told to. Without this, every page and
    // robots.txt bypassed worker.js, so the hostname guard that keeps the
    // staging .workers.dev URL out of Google never ran (caught 21 Sept).
    //
    // Pages, robots.txt, /api/* and VIDEO run through the Worker: hostname
    // guard, http->https redirect, _redirects, and byte-range support for
    // .mp4. Images are served natively by the asset server so they do not
    // count against the Workers Free 100k/day cap (over which requests 429
    // rather than fall back to static serving). _headers applies either way.
    //
    // Measured 22 Sept: NEITHER the asset server nor env.ASSETS.fetch honours
    // Range requests - every asset answers 200 with the whole file. iOS Safari
    // will not play <video> without 206, and Chrome re-fetched the 7 MB hero
    // four times per page load. worker.js therefore serves single-range 206
    // responses for .mp4 itself, streaming rather than buffering.
    // Exclusions name image TYPES rather than the folder, so /img/*.mp4 still
    // reaches the Worker - that is where byte-range support lives.
    "run_worker_first": ["/*", "!/img/*.jpg", "!/img/*.jpeg", "!/img/*.png", "!/img/*.webp", "!/img/*.svg", "!/img/*.ico"]
  },
  "observability": {
    "enabled": true
  },

  // Mail settings for the contact form.
  //
  // THESE MUST LIVE HERE, NOT IN THE DASHBOARD. The build runs
  // `npx wrangler deploy`, which treats this file as the whole truth and
  // wipes any runtime variable set through the dashboard that is not
  // declared here. That is why variables added by hand kept disappearing.
  //
  // The API key is deliberately absent: secrets never belong in a config
  // file that lives in git. RESEND_API_KEY stays a dashboard Secret, and
  // wrangler leaves secrets alone.
  "vars": {
    // Resend will not send from an unverified domain. onboarding@resend.dev
    // is their test sender and needs no DNS. Becomes a club address once
    // pinelakecc.com is verified in Resend.
    "MAIL_FROM": "Pine Lake Website <onboarding@resend.dev>",

    // Where enquiries are meant to go, once the test switch comes off.
    "MAIL_MEMBERSHIP": "melanie@pinelakecc.com",
    "MAIL_EVENTS": "anna@pinelakecc.com",

    // TEST SWITCH. While this is set, every submission goes here instead of
    // the club, subject-prefixed [TEST], and the body names who it would
    // have reached.
    //
    // THIS IS NOT A FREE-STANDING SWITCH, despite how it reads. Resend will
    // only deliver to the account owner's own address until a domain is
    // verified, and MAIL_FROM above is still Resend's shared test sender.
    // Delete this line before a domain is verified and every submission
    // fails with a 502 instead of reaching Melanie and Anna - the form looks
    // broken to the visitor and nobody at the club hears about the enquiry.
    //
    // The order is: verify a sending domain in Resend, point MAIL_FROM at a
    // club address on it, confirm a real send arrives, and only then remove
    // this line. See LAUNCH.md.
    "MAIL_TEST_TO": "1902pinelakecc@gmail.com"
  }
}
